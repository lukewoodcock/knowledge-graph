# Copy to .env and adjust.

# Absolute path to your Obsidian vault on the host machine.
VAULT_HOST_PATH=/Users/yourname/Documents/MyVault

# Model to use — must be pulled into Ollama first.
OLLAMA_MODEL=qwen3.5:9b

# Let thinking models reason before answering. Much slower (minutes per run).
OLLAMA_THINK=false

# Ollama API base URL (container-internal default; change for remote Ollama).
OLLAMA_URL=http://ollama:11434

# Port the webhook service listens on. docker compose publishes it on the
# host's loopback only (127.0.0.1), so nobody else on the network can reach it.
PORT=5678

# Address the service listens on when run directly (npm start / npm run dev).
# Loopback by default; set 0.0.0.0 only if you really want it on the network.
# docker compose sets this to 0.0.0.0 inside the container itself.
HOST=127.0.0.1

# Also write a best-practices research note for every code capture. Off by
# default: the graph holds your own work, and runs take about half the time.
RESEARCHER_ENABLED=false
