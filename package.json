{
  "name": "swarm-kg",
  "version": "1.0.0",
  "description": "Local AI agent swarm knowledge graph — TypeScript service + Ollama, writing to an Obsidian vault",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "4.22.2"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "20.19.42",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
