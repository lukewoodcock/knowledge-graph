{
  "name": "swarm-kg",
  "version": "1.0.0",
  "description": "Local AI agent swarm knowledge graph — TypeScript service + Ollama, writing to an Obsidian vault",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "reindex": "node dist/reindex.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "4.22.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "20.19.42",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "form-data": "4.0.6",
    "nanoid": "3.3.20",
    "postcss": "8.5.30",
    "source-map-js": "1.2.2",
    "vite": "8.1.6"
  }
}
