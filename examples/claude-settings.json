{
  "permissions": {
    "allow": [
      "Skill(recall)",
      "mcp__swarm-kg__search_notes",
      "mcp__swarm-kg__get_note",
      "mcp__swarm-kg__related_notes"
    ]
  },
  "enabledMcpjsonServers": ["swarm-kg"],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SWARM_KG_VAULT_PATH=/ABSOLUTE/PATH/TO/vault node /ABSOLUTE/PATH/TO/swarm-kg/dist/hook/stop.js",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
