{
  "permissions": {
    "allow": [
      "Skill(recall)",
      "mcp__knowledge-graph__search_notes",
      "mcp__knowledge-graph__get_note",
      "mcp__knowledge-graph__related_notes"
    ]
  },
  "enabledMcpjsonServers": ["knowledge-graph"],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KG_VAULT_PATH=/ABSOLUTE/PATH/TO/vault node /ABSOLUTE/PATH/TO/knowledge-graph/dist/hook/stop.js",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
